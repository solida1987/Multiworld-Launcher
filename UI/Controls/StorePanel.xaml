<UserControl x:Class="LauncherV2.UI.Controls.StorePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BrushBackground}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!--  Filters. Checkboxes INCLUDE; nothing ticked means everything,
              because a store that can be filtered down to a void looks broken
              rather than filtered. -->
        <Border Grid.Column="0" Background="#141720" BorderBrush="#262C3E"
                BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16,14,16,20">
                    <TextBlock Text="SEARCH" FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource BrushMuted}" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtSearch" Padding="8,6"
                             ToolTip="Name, description or genre"
                             TextChanged="Filters_Changed"/>

                    <TextBlock Text="SYSTEM" FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource BrushMuted}" Margin="0,16,0,6"/>
                    <StackPanel x:Name="PanelPlatforms"/>

                    <TextBlock Text="GENRE" FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource BrushMuted}" Margin="0,16,0,6"/>
                    <StackPanel x:Name="PanelGenres"/>

                    <TextBlock Text="STATUS" FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource BrushMuted}" Margin="0,16,0,6"/>
                    <CheckBox x:Name="ChkTestedOnly" Content="Tested only" FontSize="12"
                              Foreground="{StaticResource BrushText}"
                              ToolTip="Only games somebody has played through London end to end"
                              Checked="Filters_Changed" Unchecked="Filters_Changed"/>

                    <Button x:Name="BtnClearFilters" Content="Clear filters"
                            Style="{StaticResource BtnSecondaryStyle}" Padding="0,6"
                            Margin="0,16,0,0" Click="BtnClearFilters_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="18,13,18,12">
                <StackPanel>
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TxtStoreCount" FontSize="14" FontWeight="Bold"
                                       Foreground="{StaticResource BrushText}" Text="Plugin Library"/>
                            <TextBlock x:Name="TxtStoreNote" FontSize="11" Margin="14,3,0,0"
                                       Foreground="{StaticResource BrushMuted}"
                                       Text="Installing runs the same consent screen as a file you picked yourself."/>
                        </StackPanel>
                        <Button x:Name="BtnStoreRefresh" Content="Refresh"
                                Style="{StaticResource BtnSecondaryStyle}" Padding="12,5"
                                HorizontalAlignment="Right" Click="BtnStoreRefresh_Click"/>
                    </Grid>

                    <!--  Who to ask when a plugin misbehaves.
                          Players reasonably assume a plugin that starts their
                          game is something the game's makers built. They did
                          not, and neither did most of the world authors — the
                          packaging is ours. Someone chasing a launcher bug
                          through a publisher's support form gets nowhere and
                          wastes the publisher's time too, so this is stated
                          before anything is installed rather than after. -->
                    <Border Margin="0,12,0,0" Background="#1B1710" BorderBrush="#4A3C18"
                            BorderThickness="1" CornerRadius="5" Padding="15,11,15,12">
                        <StackPanel>
                            <TextBlock FontSize="13" FontWeight="Bold"
                                       Foreground="{StaticResource BrushAccent}"
                                       Text="Something not working? Come to us — not to the game's makers."/>
                            <TextBlock Margin="0,6,0,0" FontSize="12" LineHeight="18"
                                       TextWrapping="Wrap" MaxWidth="1060"
                                       HorizontalAlignment="Left"
                                       Foreground="{StaticResource BrushText}"
                                       Text="Almost everything here is a community integration. The plugin that installs and starts the game is ours. The Archipelago world inside it was written by the person credited on each card. The company that made the game has nothing to do with either, does not know this exists, and cannot help you with it — and neither the publisher nor the world's author has agreed to support it."/>
                            <TextBlock Margin="0,7,0,0" FontSize="12" LineHeight="18"
                                       TextWrapping="Wrap" MaxWidth="1060"
                                       HorizontalAlignment="Left"
                                       Foreground="{StaticResource BrushText}"
                                       Text="So if a game will not install, will not connect, or sends no checks: report it to us and we will look at it. Every card says which kind it is — the few marked Supported here are ours end to end, and those are the ones we can promise to fix."/>
                            <TextBlock x:Name="TxtSupportLink" Margin="0,8,0,0" FontSize="12"
                                       Foreground="{StaticResource BrushAccent}"
                                       Cursor="Hand" TextDecorations="Underline"
                                       MouseLeftButtonUp="TxtSupportLink_Click"
                                       Text="Report a problem on BetaHub  →"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,0,18,18">
                <StackPanel>
                    <WrapPanel x:Name="PanelGames"/>
                    <TextBlock x:Name="TxtStoreEmpty" Visibility="Collapsed"
                               Margin="0,60,0,0" HorizontalAlignment="Center"
                               FontSize="13" Foreground="{StaticResource BrushMuted}"
                               Text="Nothing matches those filters."/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
